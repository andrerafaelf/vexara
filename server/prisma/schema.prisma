generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(20)
  email     String    @unique
  password  String
  points    Int       @default(0)
  createdAt DateTime  @default(now())
  nexuses  Nexus[]

  questRewardClaims Json @default("[]")
  completedQuestIds Json @default("[]")
  nexusGroups       Json @default("[]")
}

model Nexus {
  id   Int    @id @default(autoincrement())
  name String

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  x Int
  y Int

  // Resources
  biomass Float @default(500)
  alloy   Float @default(500)
  ore     Float @default(500)

  // Buildings
  commandCore     Int @default(0)
  recruitmentCore Int @default(0)
  lifeSupport     Int @default(1)
  storageVault    Int @default(1)
  biomassFarm     Int @default(1)
  alloyForge      Int @default(1)
  oreExtractor    Int @default(1)
  shieldGrid      Int @default(0)

  // Troops
  lancerDrone         Int @default(0)
  assaultTrooper      Int @default(0)
  breakerUnit         Int @default(0)
  reconOperative      Int @default(0)
  skimmerBike         Int @default(0)
  siegeMech           Int @default(0)
  bulwarkGuard        Int @default(0)
  suppressorTeam      Int @default(0)
  disruptorUnit       Int @default(0)
  interceptorBike     Int @default(0)
  annihilatorPlatform Int @default(0)
  overseer            Int @default(0)

  // Population
  populationCurrent Int @default(5)
  populationMax     Int @default(24)

  // Queues (JSON arrays)
  buildQueue         Json @default("[]")
  trainingQueue      Json @default("[]")

  lastResourceUpdate DateTime @default(now())
  points               Int       @default(5)
  controlLevel         Int       @default(100)
  createdAt            DateTime  @default(now())

  attacksAsAttacker  Attack[]         @relation("AttackerNexus")
  attacksAsDefender  Attack[]         @relation("DefenderNexus")
  marketListings     MarketListing[]
  troopsSent         TroopTransfer[]  @relation("OwnerNexus")
  troopsHosted       TroopTransfer[]  @relation("HostNexus")
}

enum TransferStatus {
  traveling
  stationed
  returning
}

model TroopTransfer {
  id           Int            @id @default(autoincrement())
  ownerNexusId Int
  hostNexusId  Int
  troops       Json
  status       TransferStatus @default(stationed)
  arrivesAt    DateTime?
  returnsAt    DateTime?
  createdAt    DateTime       @default(now())

  ownerNexus Nexus @relation("OwnerNexus", fields: [ownerNexusId], references: [id], onDelete: Cascade)
  hostNexus  Nexus @relation("HostNexus",  fields: [hostNexusId],  references: [id], onDelete: Cascade)
}

model ReportRead {
  userId   Int
  attackId Int
  readAt   DateTime @default(now())

  @@id([userId, attackId])
}

model MarketTransaction {
  id             Int      @id @default(autoincrement())
  sellerNexusId  Int
  sellerUsername String
  buyerNexusId   Int
  buyerUsername  String
  offerResource  String
  offerAmount    Int
  wantResource   String
  wantAmount     Int
  completedAt    DateTime @default(now())
}

model MarketListing {
  id            Int      @id @default(autoincrement())
  sellerNexusId Int
  sellerNexus   Nexus    @relation(fields: [sellerNexusId], references: [id], onDelete: Cascade)
  offerResource String
  offerAmount   Int
  wantResource  String
  wantAmount    Int
  createdAt     DateTime @default(now())
}

enum AttackType {
  attack
  support
  scout
}

enum AttackStatus {
  traveling
  completed
  cancelled
}

model Attack {
  id Int @id @default(autoincrement())

  attackerUserId    Int
  attackerNexusId Int
  defenderUserId    Int?
  defenderNexusId Int

  attackerNexus Nexus @relation("AttackerNexus", fields: [attackerNexusId], references: [id])
  defenderNexus Nexus @relation("DefenderNexus", fields: [defenderNexusId], references: [id])

  troops    Json
  arrivesAt DateTime
  type      AttackType   @default(attack)
  status    AttackStatus @default(traveling)
  result    Json?

  createdAt DateTime @default(now())
}
