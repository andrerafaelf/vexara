generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique @db.VarChar(20)
  email          String    @unique
  password       String
  isAlphaFounder Boolean   @default(false)
  isBetaFounder  Boolean   @default(false)
  isSupporter    Boolean   @default(false)
  supporterSince DateTime?
  supporterTier  String?   @db.VarChar(16)
  supporterTierSince DateTime?
  isFounder      Boolean   @default(false)
  avatarKey      String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())

  emailVerifiedAt                   DateTime?
  emailVerificationToken            String?   @unique @db.VarChar(64)
  emailVerificationTokenExpiresAt   DateTime?
  passwordResetToken                String?   @unique @db.VarChar(64)
  passwordResetTokenExpiresAt       DateTime?
  nexuses  Nexus[]

  activeGalaxyId Int?
  activeGalaxy   Galaxy? @relation("UserActiveGalaxy", fields: [activeGalaxyId], references: [id])

  galaxyPlayers  GalaxyPlayer[]
  seasonRecords  SeasonRecord[]

  friendshipsA       Friendship[]    @relation("FriendshipUserA")
  friendshipsB       Friendship[]    @relation("FriendshipUserB")
  friendRequestsSent FriendRequest[] @relation("FriendRequestSender")
  friendRequestsRecv FriendRequest[] @relation("FriendRequestReceiver")
  chatMessagesSent   ChatMessage[]   @relation("ChatMessageSender")
  chatMessagesRecv   ChatMessage[]   @relation("ChatMessageReceiver")
  pushSubscriptions  PushSubscription[]
  notificationPrefs  NotificationPreferences?
  factionMembers   FactionMember[]
  factionMessages  FactionMessage[]
  factionJoinRequests FactionJoinRequest[]
  diplomacyMessages DiplomacyMessage[]

  referredById     Int?
  registrationIp   String?   @db.VarChar(45)
  referralCode     String    @unique @db.VarChar(12)
  utmSource        String?   @db.VarChar(64)
  utmMedium        String?   @db.VarChar(64)
  utmCampaign      String?   @db.VarChar(64)
  referredBy       User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("UserReferrals")
  referralTokens   ReferralToken[]
  milestoneTokens  MilestoneToken[]

  lastSeenWarsAt   DateTime?
  lastPlayedAt     DateTime?

  wavePlans WavePlan[]
  standingOrders StandingOrder[]
  queueTemplates QueueTemplate[]
  autoRequeueRules AutoRequeueRule[]

  beginnerTipsEnabled Boolean  @default(true)
  onboardingStep      String?  @db.VarChar(64)
  referralClickCount  Int      @default(0)

  isFlagged        Boolean   @default(false)
  flagReason       String?   @db.VarChar(200)
  flaggedAt        DateTime?

  galaxiesWon      Int       @default(0)
  galaxiesPlayed   Int       @default(0)
  lifetimePoints   Int       @default(0)

  // Vex Points balance. Earned via battle pass rewards; spent on the pass itself
  // (1,000 VP = one paid pass) and future shop items. €4.99 purchase grants 1,000 VP.
  vexPoints Int @default(0)

  // Best Vex Protocol pass title ever earned across all seasons (promoted from
  // GalaxyPlayer.passTitle at season end). Separate from commanderTitle which
  // is derived from combat/galaxy stats via resolveTitle().
  passTitle     String? @db.VarChar(32)

  // Permanent badge collection. Array of tier strings granted by the battle pass:
  // ["bronze", "silver", "gold", "platinum"]. Highest tier badge wins display.
  earnedBadges  Json    @default("[]")

  // All pass titles ever earned across seasons. Superset of passTitle.
  earnedTitles  Json    @default("[]")

  // The title the player has chosen to display on their public profile (max 1).
  // Must be a member of earnedTitles. Null = no title shown.
  activeTitle   String? @db.VarChar(32)

  // Key of the avatar border purchased from the shop and currently equipped.
  // References ShopItem.key where type='border'. Null = no border.
  avatarBorder  String? @db.VarChar(64)

  // Timestamp of last username change. Enforces the 30-day cooldown.
  usernameChangedAt DateTime?

  // Set to true by the 20260615030000 migration that granted 1,000 VP to all
  // pre-launch users. Prevents double-grants on re-run.
  earlyAccessVpGranted Boolean @default(false)

  // Set when this (referred) user first reaches the referral VP-bonus influence
  // threshold, triggering a one-time 250 VP grant to both this user and their
  // referrer. Null = not yet granted. Idempotency key for the bonus.
  referralVpBonusAt DateTime?

  shopPurchases ShopPurchase[]

  // Permanent, account-wide Vex Pass. Lifetime pass XP across every galaxy.
  // Level = min(50, floor(passXp / 200)); XP past 10,000 feeds repeatable caches.
  // Supersedes GalaxyPlayer.seasonXp / passLevel.
  passXp      Int     @default(0)
  // Paid track unlock. Supersedes GalaxyPlayer.hasPaidPass.
  hasPaidPass Boolean @default(false)
  // Daily pass XP cap (800 XP per UTC day). passXpDay is the UTC date key
  // ('YYYY-MM-DD', toISOString().slice(0,10)) the total belongs to; when it no
  // longer matches today the total is treated as 0.
  passXpDay      String? @db.VarChar(10)
  passXpDayTotal Int     @default(0)
  passClaims  PassClaim[]

  // Set on password change/reset. Any JWT issued (iat) before this is rejected by
  // auth middleware and socket auth. Null = no revocation.
  passwordChangedAt DateTime?
}

// One row per claimed Vex Pass reward. The (userId, level, track) unique
// constraint is the atomic claim lock: insert first, a duplicate means already
// claimed. Separate tracks let a player who buys the paid pass later still claim
// the paid half of levels they already claimed for free.
model PassClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  // 'free' | 'paid' (levels 1..50) | 'cache' (post-50 repeatable caches,
  // level 51 = cache #1, 52 = cache #2, ...). The app always sets it, no default.
  track     String   @db.VarChar(8)
  // 1..50 for free/paid; 51+ for cache.
  level     Int
  // Audit only, deliberately no FKs: galaxies and nexuses can be deleted.
  galaxyId  Int?
  nexusId   Int?
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, track])
}

// Claim-before-process ledger for Ko-fi webhook deliveries. Insert first; a
// duplicate transactionId means the delivery was already processed (Ko-fi retries
// must never double-credit Vex Points).
model KofiWebhookEvent {
  id            Int      @id @default(autoincrement())
  // Ko-fi kofi_transaction_id.
  transactionId String   @unique @db.VarChar(128)
  // Donation | Subscription | Shop Order | Commission
  type          String   @db.VarChar(32)
  // Matched user if any. No FK on purpose: audit only, survives user deletion.
  userId        Int?
  amount        String?  @db.VarChar(32)
  receivedAt    DateTime @default(now())

  @@index([userId])
}

// Permanent record of every shop purchase. Used for de-duplication
// (one-time items), audit trail, and restoring inventory after rollbacks.
model ShopPurchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemKey   String   @db.VarChar(64)
  itemType  String   @db.VarChar(32)
  vpSpent   Int
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemKey])
  @@index([userId, createdAt])
}

enum GalaxyStatus {
  active
  ended
}

enum FactionRole {
  leader
  officer
  member
}

model Galaxy {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  status       GalaxyStatus @default(active)
  startsAt     DateTime?
  endedAt      DateTime?
  winnerUserId Int?
  winnerFactionId Int?
  createdAt    DateTime     @default(now())

  // When true, no new players may join (existing members keep playing). Set by admins.
  isLocked     Boolean      @default(false)

  // Optional season end date. When set, a background job ends the galaxy at this
  // time if the dominance condition hasn't already fired. NULL = no timer.
  seasonEndsAt DateTime?

  // Per-galaxy dominance victory config. NULL = fall back to the engine defaults in
  // utils/dominance.ts (0.65 share, 36h sustain, 15 players, 4 factions). Lets admins
  // tune the win condition per world without a redeploy.
  winShare        Float? // map share a faction must hold, e.g. 0.65
  winSustainHours Int?   // hours that share must be sustained before the galaxy ends
  winMinPlayers   Int?   // minimum players in the galaxy for victory to be eligible
  winMinFactions  Int?   // minimum distinct factions for victory to be eligible

  // Speed world multiplier. 1.0 = normal, 5.0 = 5× speed. Divides all duration-based
  // calculations (travel, builds, training, production elapsed-time). Default 1.0 is a
  // no-op so all existing galaxies are unaffected.
  speedMultiplier Float @default(1.0)

  activeUsers        User[]              @relation("UserActiveGalaxy")
  players            GalaxyPlayer[]
  nexuses            Nexus[]
  attacks            Attack[]
  troopTransfers     TroopTransfer[]
  marketListings     MarketListing[]
  marketTransactions MarketTransaction[]
  reportReads        ReportRead[]
  factions           Faction[]
  galaxyEvents       GalaxyEvent[]
  factionTreaties    FactionTreaty[]
  wavePlans          WavePlan[]
  galaxyAlerts       GalaxyAlert[]
  standingOrders     StandingOrder[]
  queueTemplates     QueueTemplate[]
  autoRequeueRules   AutoRequeueRule[]
}

// Email alert opt-in for a scheduled (pending) galaxy. One row per email per galaxy.
// Sent via broadcastGalaxyAlert() when the admin triggers the launch notification.
model GalaxyAlert {
  id        Int       @id @default(autoincrement())
  galaxyId  Int
  email     String    @db.VarChar(254)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@unique([galaxyId, email])
  @@index([galaxyId])
}

model GalaxyPlayer {
  id          Int      @id @default(autoincrement())
  userId      Int
  galaxyId    Int
  points      Int      @default(0)
  // Highest total influence this player has ever held in this galaxy. Used to
  // size an eliminated player's respawn nexus to a fraction of their former
  // strength so a returning veteran isn't reset to a bare starter. Monotonic:
  // only ever increased, never reset on elimination.
  peakPoints  Int      @default(0)
  finalPoints Int?
  joinedAt    DateTime @default(now())

  questRewardClaims Json @default("[]")
  completedQuestIds Json @default("[]")
  nexusGroups       Json @default("[]")

  dominanceSince DateTime?

  // DEPRECATED: seasonXp, passLevel, hasPaidPass, passTitle and claimedLevels are
  // superseded by User.passXp / User.hasPaidPass / PassClaim. Kept for rollback
  // only; drop in a later release.
  seasonXp      Int     @default(0)
  passLevel     Int     @default(0)
  hasPaidPass   Boolean @default(false)
  // DEPRECATED. Highest pass title earned this season. Promoted to User.earnedTitles at season end.
  passTitle     String? @db.VarChar(32)
  // DEPRECATED (see PassClaim). JSON array of level numbers already claimed.
  claimedLevels Json    @default("[]")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@unique([userId, galaxyId])
  @@index([galaxyId])
}

// Permanent per-user record of each galaxy they participated in.
// Written by endGalaxy() so the Hall of Champions has a stable snapshot
// that survives GalaxyPlayer row mutations and player deletions.
model SeasonRecord {
  id           Int      @id @default(autoincrement())
  userId       Int
  galaxyId     Int
  galaxyName   String   @db.VarChar(64)
  endedAt      DateTime
  points       Int
  won          Boolean
  factionName  String?  @db.VarChar(32)
  factionTag   String?  @db.VarChar(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([galaxyId])
  @@index([endedAt])
}

// Singleton global config row (always id = 1). Use upsert to read/write.
model AppConfig {
  id           Int       @id @default(1)
  // Global season end date. When set, all active galaxies end at this time
  // (winner = faction with most nexuses). NULL = no active season timer.
  seasonEndsAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model AlphaSignup {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(254)
  createdAt         DateTime  @default(now())
  invitedAt         DateTime?
  unsubscribedAt    DateTime?
  unsubscribeToken  String?   @unique @db.VarChar(64)
  source            String?   @db.VarChar(64)
  utmSource         String?   @db.VarChar(64)
  utmMedium         String?   @db.VarChar(64)
  utmCampaign       String?   @db.VarChar(64)

  @@index([createdAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreferences {
  userId            Int     @id
  attackIncoming    Boolean @default(true)
  attackResolved    Boolean @default(true)
  troopsReturned    Boolean @default(true)
  buildingComplete  Boolean @default(true)
  troopComplete     Boolean @default(true)
  resourcesFull     Boolean @default(true)
  troopTransfer     Boolean @default(true)
  factionInvite      Boolean @default(true)
  factionPromotion   Boolean @default(true)
  factionWar         Boolean @default(true)
  factionDiplomacy   Boolean @default(true)
  factionMessage     Boolean @default(true)
  friendRequest      Boolean @default(true)
  friendMessage      Boolean @default(true)
  nearbyGalaxyEvent  Boolean @default(true)
  protectionExpiring Boolean @default(true)
  tokenGranted       Boolean @default(true)
  autoRequeuePaused  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userAId   Int
  userBId   Int
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

enum FriendRequestStatus {
  pending
  accepted
  declined
  cancelled
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendRequestStatus @default(pending)
  createdAt  DateTime            @default(now())
  respondedAt DateTime?

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId, status])
}

model ChatMessage {
  id         Int       @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String    @db.VarChar(2000)
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  sender   User @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ChatMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([receiverId, readAt])
}

model Nexus {
  id   Int    @id @default(autoincrement())
  name String

  galaxyId Int
  galaxy   Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  x Int
  y Int

  // Resources
  biomass Float @default(1500)
  alloy   Float @default(1500)
  ore     Float @default(1500)

  // Buildings
  commandCore     Int @default(0)
  hangarBay       Int @default(0)
  plasmaForge     Int @default(0)
  armorFoundry    Int @default(0)
  lifeSupport     Int @default(1)
  storageVault    Int @default(1)
  biomassFarm     Int @default(1)
  alloyForge      Int @default(1)
  oreExtractor    Int @default(1)
  shieldGrid      Int @default(0)
  targetingCore   Int @default(0)
  stealthArray    Int @default(0)

  // Troops
  sentinelLancer      Int @default(0)
  assaultTrooper      Int @default(0)
  vanguardBreaker     Int @default(0)
  reconOperative      Int @default(0)
  wraithSkimmer       Int @default(0)
  siegeMech           Int @default(0)
  bulwarkGuard        Int @default(0)
  pyreSuppressor      Int @default(0)
  arcDisruptor        Int @default(0)
  phantomLance        Int @default(0)
  annihilatorPlatform Int @default(0)
  voidStalker         Int @default(0)
  plasmaTurret        Int @default(0)
  overseer            Int @default(0)
  siegeColossus       Int @default(0)
  aegisSkirmisher     Int @default(0)

  // Population
  populationCurrent Int @default(5)
  populationMax     Int @default(24)

  // Queues (JSON arrays)
  buildQueue         Json @default("[]")
  trainingQueue      Json @default("[]")

  // Per-troop-type lifetime trained counter. Used by quest progress so that
  // troops lost in combat don't roll back "train N units" quest completion.
  troopsTrained      Json @default("{}")

  nexusType            String?
  nexusTypeLockedAt    DateTime?
  nexusTypeDoubled     Boolean   @default(false)

  // Derelict Ship galaxy event capture: grants 3x production (4x at CC15) on top of Resource Depot baseline math.
  // Permanent flag once captured; persists through renames and ownership changes.
  isDerelict           Boolean   @default(false)

  lastResourceUpdate       DateTime  @default(now())
  // Stamped whenever the owner takes a deliberate action on this nexus (train,
  // build, cancel, decommission) via atomicUpdateNexusResources. Surfaced to
  // OTHER players on the map as an "active" indicator that lapses after
  // NEXUS_ACTIVE_WINDOW_MS of inactivity — a lightweight presence signal.
  lastActivityAt           DateTime?
  points                   Int       @default(5)
  controlLevel             Int       @default(100)
  // Anchor for time-based control regen: advanced by the whole hours consumed
  // each tick so regen reflects real elapsed time and is immune to server
  // restart cadence (no free tick on boot, no lost time from frequent deploys).
  lastControlRecoverAt     DateTime  @default(now())
  newbieProtectionEndsAt   DateTime?
  protectionWarningSentAt  DateTime?
  // One-time newbie relocation token, lifecycle-bound to the starter nexus.
  // Granted on fresh signup (not on eliminated-respawn); consumed when the
  // player relocates near a chosen nexus. Dead once newbie protection lapses.
  relocationTokenAvailable Boolean   @default(false)
  relocationTokenUsedAt    DateTime?
  createdAt                DateTime  @default(now())
  conqueredAt              DateTime?
  rebuildBonusEndsAt       DateTime?

  attacksAsAttacker  Attack[]         @relation("AttackerNexus")
  attacksAsDefender  Attack[]         @relation("DefenderNexus")
  marketListings     MarketListing[]
  troopsSent         TroopTransfer[]  @relation("OwnerNexus")
  troopsHosted       TroopTransfer[]  @relation("HostNexus")
  wavePlansTargeting WavePlan[]       @relation("WavePlanTarget")
  standingOrdersProtecting StandingOrder[] @relation("StandingOrderProtected")
  standingOrdersSourced    StandingOrder[] @relation("StandingOrderSource")
  autoRequeueRules         AutoRequeueRule[]

  @@index([galaxyId])
  @@index([ownerId, galaxyId])
  @@index([controlLevel])
}

enum TransferStatus {
  traveling
  stationed
  returning
}

model TroopTransfer {
  id           Int            @id @default(autoincrement())
  galaxyId     Int
  ownerNexusId Int
  hostNexusId  Int
  troops       Json
  status       TransferStatus @default(stationed)
  arrivesAt    DateTime?
  returnsAt    DateTime?
  createdAt    DateTime       @default(now())

  galaxy     Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  ownerNexus Nexus  @relation("OwnerNexus", fields: [ownerNexusId], references: [id], onDelete: Cascade)
  hostNexus  Nexus  @relation("HostNexus",  fields: [hostNexusId],  references: [id], onDelete: Cascade)

  @@index([galaxyId])
  @@index([status, arrivesAt])
  @@index([ownerNexusId, status])
}

model ReportRead {
  userId   Int
  attackId Int
  galaxyId Int
  readAt   DateTime @default(now())

  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@id([userId, attackId])
  @@index([galaxyId])
}

model MarketTransaction {
  id             Int      @id @default(autoincrement())
  galaxyId       Int
  sellerNexusId  Int
  sellerUsername String
  buyerNexusId   Int
  buyerUsername  String
  offerResource  String
  offerAmount    Int
  wantResource   String
  wantAmount     Int
  completedAt    DateTime @default(now())

  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@index([galaxyId])
}

model MarketListing {
  id            Int      @id @default(autoincrement())
  galaxyId      Int
  sellerNexusId Int
  galaxy        Galaxy   @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  sellerNexus   Nexus    @relation(fields: [sellerNexusId], references: [id], onDelete: Cascade)
  offerResource String
  offerAmount   Int
  wantResource  String
  wantAmount    Int
  createdAt     DateTime @default(now())

  @@index([galaxyId])
  @@index([sellerNexusId])
}

enum AttackType {
  attack
  support
  scout
}

enum AttackStatus {
  traveling
  returning
  completed
  cancelled
}

enum ScheduledAttackStatus {
  pending
  launched
  failed
  cancelled
}

model Attack {
  id Int @id @default(autoincrement())

  galaxyId Int
  galaxy   Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  attackerUserId    Int?
  attackerNexusId Int
  defenderUserId    Int?
  defenderNexusId Int

  attackerNexus Nexus @relation("AttackerNexus", fields: [attackerNexusId], references: [id])
  defenderNexus Nexus @relation("DefenderNexus", fields: [defenderNexusId], references: [id])

  troops    Json
  arrivesAt DateTime
  returnsAt DateTime?
  type      AttackType   @default(attack)
  status    AttackStatus @default(traveling)
  result    Json?

  clientRequestId String? @unique
  createdAt DateTime @default(now())

  // Coordination pointers (PR1 of coordinated assault). At most ONE is set on
  // any Attack — enforced by the attack_one_coordination CHECK constraint added
  // in the migration. The resolver groups arriving Attacks by these in PR2;
  // PR1 only writes them.
  wavePlanId         Int?
  wavePlan           WavePlan?         @relation(fields: [wavePlanId], references: [id], onDelete: SetNull)
  warOperationWaveId Int?
  warOperationWave   WarOperationWave? @relation(fields: [warOperationWaveId], references: [id], onDelete: SetNull)

  @@index([galaxyId])
  @@index([status, arrivesAt])
  @@index([attackerNexusId, status])
  @@index([defenderNexusId, status])
  @@index([arrivesAt, status, wavePlanId])
  @@index([arrivesAt, status, warOperationWaveId])
}

// A wave/attack queued to launch at a future moment. Persisted server-side so it
// fires whether or not the planning client is online (the in-browser Wave Planner
// only fired while the tab stayed open). The processScheduledAttacks job picks up
// rows where status='pending' AND launchAt <= now and runs attackService.launchAttack,
// which re-validates ownership/troops/protection at fire time. IDs are stored as
// plain scalars (no FK relations) intentionally — the launcher tolerates a missing
// nexus by marking the row failed.
model ScheduledAttack {
  id Int @id @default(autoincrement())

  galaxyId    Int
  userId      Int
  fromNexusId Int
  toNexusId   Int
  troops      Json
  type        AttackType @default(attack)

  launchAt DateTime
  status   ScheduledAttackStatus @default(pending)
  error    String?               @db.VarChar(256)
  // Forwarded to launchAttack so the resulting Attack is idempotent on retries.
  clientRequestId String? @unique

  // Coordination pointer (PR1 of coordinated assault). Stamped at schedule time
  // and propagated onto the resulting Attack at launch. SetNull keeps a row's
  // lineage queryable even if the plan is later deleted.
  wavePlanId Int?
  wavePlan   WavePlan? @relation(fields: [wavePlanId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, launchAt])
  @@index([userId])
  @@index([galaxyId])
  @@index([wavePlanId])
}

// A solo player's wave plan against a single target. Created/reused by the
// scheduleAttack endpoint when the call carries a wavePlanId hint (or when the
// player's most recent active plan for that target is reusable). Invisible to
// the player UI — it's the server-side glue that lets multiple WavePlanner
// waves landing at the same arrivesAt resolve as one merged combat (PR2).
//
// Mirrors WarOperationWave for the multi-player case. There is no lifecycle
// status here: a WavePlan is "active" as long as any of its ScheduledAttacks
// are still pending or its Attacks haven't all resolved; otherwise it's just
// historical metadata kept for queryability and combat-log lineage.
model WavePlan {
  id            Int      @id @default(autoincrement())
  userId        Int
  galaxyId      Int
  targetNexusId Int
  createdAt     DateTime @default(now())

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxy      Galaxy  @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  targetNexus Nexus   @relation("WavePlanTarget", fields: [targetNexusId], references: [id], onDelete: Cascade)

  scheduledAttacks ScheduledAttack[]
  attacks          Attack[]

  @@index([userId, galaxyId, targetNexusId])
  @@index([createdAt])
}

// A persistent "if my nexus is attacked, auto-send support from my reserve
// nexus" rule. Reuses the existing support-mission rails (attackService.
// launchAttack with type='support', stationed via TroopTransfer) rather than
// inventing a new defense mechanic — a standing order is just a pre-armed
// trigger for a mission a player could already send manually. Fired from the
// same call site in launchAttack that sends the ATTACK_INCOMING push, so no
// new background job/interval is needed (PR for Phase 2 of the roadmap).
model StandingOrder {
  id       Int @id @default(autoincrement())
  userId   Int
  galaxyId Int

  // The nexus this order watches. When it receives an incoming attack, the
  // order may fire.
  protectedNexusId Int
  // The nexus reserve troops are transferred FROM (via troopTransferService).
  sourceNexusId    Int

  troops Json

  isActive Boolean @default(true)

  // Cooldown + dedup: prevents one inbound wave's multiple attacks (or
  // repeated raids in quick succession) from draining the source nexus by
  // firing the same order over and over. Stamped every time the order fires;
  // the next eligible fire must be at least STANDING_ORDER_COOLDOWN_MS later.
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxy         Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  protectedNexus Nexus @relation("StandingOrderProtected", fields: [protectedNexusId], references: [id], onDelete: Cascade)
  sourceNexus    Nexus @relation("StandingOrderSource", fields: [sourceNexusId], references: [id], onDelete: Cascade)

  @@unique([protectedNexusId, sourceNexusId])
  @@index([userId, galaxyId])
  @@index([protectedNexusId, isActive])
}

// Named, reusable training-queue presets ("repeat-last" / saved templates).
// Replaying a template just re-submits {troopType, amount} through the
// existing POST /api/troop/train endpoint, so all cost/population/queue
// validation in troopController.trainTroops still applies unchanged.
model QueueTemplate {
  id       Int @id @default(autoincrement())
  userId   Int
  galaxyId Int

  name      String @db.VarChar(40)
  troopType String @db.VarChar(32)
  amount    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@index([userId, galaxyId])
}

// Auto-requeue rule: re-queues a training batch or building upgrade each
// time the previous one drains, picked up by processCompletedQueuesAndNotify
// (server/models/Nexus.ts). Building rules call buildingController's
// attemptUpgradeBuilding and training rules call troopController's
// attemptTrainTroops, so they get the exact same validation as the manual
// endpoints. A validation failure (e.g. a missing-requirement gate) pauses
// the rule (isActive=false) and notifies the player instead of erroring
// silently — see autoRequeueService.ts.
model AutoRequeueRule {
  id       Int @id @default(autoincrement())
  userId   Int
  galaxyId Int
  nexusId  Int

  // "training" | "building"
  kind String @db.VarChar(16)

  // Set when kind = "training".
  troopType String? @db.VarChar(32)
  amount    Int?

  // Set when kind = "building". Always means "upgrade to next level".
  building String? @db.VarChar(32)

  isActive Boolean @default(true)

  // Set when the rule self-pauses after a failed requeue attempt, so the
  // client can show the player why it stopped.
  pausedReason String? @db.VarChar(255)

  lastFiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  nexus  Nexus  @relation(fields: [nexusId], references: [id], onDelete: Cascade)

  @@index([userId, galaxyId])
  @@index([nexusId, isActive])
}

model Faction {
  id              Int       @id @default(autoincrement())
  galaxyId        Int
  name            String    @db.VarChar(32)
  tag             String    @db.VarChar(6)
  description     String?   @db.VarChar(256)
  motd            String?   @db.VarChar(512)
  createdAt       DateTime  @default(now())
  dominanceSince  DateTime?

  // Shared faction treasury. Members donate; officers/leaders spend on faction buffs.
  treasuryBiomass Float @default(0)
  treasuryAlloy   Float @default(0)
  treasuryOre     Float @default(0)

  galaxy   Galaxy           @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  members      FactionMember[]
  invites      FactionInvite[]
  messages     FactionMessage[]
  events       FactionEvent[]
  warsInitiated    FactionWar[]    @relation("FactionWarDeclarer")
  warsReceived     FactionWar[]    @relation("FactionWarTarget")
  joinRequests     FactionJoinRequest[]
  treatiesProposed FactionTreaty[] @relation("TreatyProposer")
  treatiesReceived FactionTreaty[] @relation("TreatyTarget")
  targets          FactionTarget[]

  @@unique([galaxyId, name])
  @@unique([galaxyId, tag])
  @@index([galaxyId])
}

model FactionTarget {
  id          Int      @id @default(autoincrement())
  factionId   Int
  galaxyId    Int
  nexusId     Int
  markedById  Int
  note        String?  @db.VarChar(128)
  createdAt   DateTime @default(now())

  faction  Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([factionId, nexusId])
  @@index([factionId, galaxyId])
  @@index([nexusId])
}

model FactionMessage {
  id        Int      @id @default(autoincrement())
  factionId Int
  userId    Int
  // 4000 to match FACTION_MSG_MAX in factionController. Combat-report shares run
  // ~1.5-2.5k chars (one block per allied contributor); the old VarChar(1000)
  // passed validation then threw a Postgres "value too long" error -> 500.
  content   String   @db.VarChar(4000)
  createdAt DateTime @default(now())

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([factionId, createdAt])
}

model FactionEvent {
  id        Int      @id @default(autoincrement())
  factionId Int
  type      String   @db.VarChar(64)
  actorName String?  @db.VarChar(64)
  targetName String? @db.VarChar(64)
  meta      String?  @db.VarChar(256)
  createdAt DateTime @default(now())

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@index([factionId, createdAt])
}

model FactionMember {
  id        Int         @id @default(autoincrement())
  factionId Int
  userId    Int
  galaxyId  Int
  role      FactionRole @default(member)
  joinedAt  DateTime    @default(now())
  lastSeenFactionMessageId Int @default(0)

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, galaxyId])
  @@index([factionId])
  @@index([factionId, lastSeenFactionMessageId])
  @@index([galaxyId])
}

model FactionInvite {
  id              Int      @id @default(autoincrement())
  factionId       Int
  invitedUserId   Int
  invitedByUserId Int
  galaxyId        Int
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([factionId, invitedUserId])
  @@index([invitedUserId, galaxyId])
}

model FactionJoinRequest {
  id        Int      @id @default(autoincrement())
  factionId Int
  userId    Int
  galaxyId  Int
  message   String?  @db.VarChar(256)
  createdAt DateTime @default(now())

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([factionId, userId])
  @@index([factionId])
  @@index([userId, galaxyId])
}

enum FactionWarStatus {
  pending
  active
  ceasefire_pending
  ended
}

model FactionWar {
  id               Int              @id @default(autoincrement())
  galaxyId         Int
  declarerFactionId Int
  targetFactionId   Int
  status           FactionWarStatus @default(pending)
  declaredAt       DateTime         @default(now())
  acceptedAt       DateTime?
  endedAt          DateTime?
  ceasefireProposerFactionId Int?

  declarerFaction Faction @relation("FactionWarDeclarer", fields: [declarerFactionId], references: [id], onDelete: Cascade)
  targetFaction   Faction @relation("FactionWarTarget",   fields: [targetFactionId],   references: [id], onDelete: Cascade)

  @@unique([declarerFactionId, targetFactionId, galaxyId])
  @@index([galaxyId])
  @@index([declarerFactionId])
  @@index([targetFactionId])
}

enum FactionTreatyType {
  nap
  trade
  vassal
}

enum FactionTreatyStatus {
  pending
  active
  expired
  cancelled
  broken
}

model FactionTreaty {
  id                 Int                 @id @default(autoincrement())
  galaxyId           Int
  type               FactionTreatyType
  status             FactionTreatyStatus @default(pending)
  proposerFactionId  Int
  targetFactionId    Int
  proposedByUserId   Int
  acceptedByUserId   Int?
  durationDays       Int?
  startsAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  brokenAt           DateTime?
  betrayalEndsAt     DateTime?
  brokenByUserId     Int?
  meta               Json?

  galaxy           Galaxy  @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  proposerFaction  Faction @relation("TreatyProposer", fields: [proposerFactionId], references: [id], onDelete: Cascade)
  targetFaction    Faction @relation("TreatyTarget",   fields: [targetFactionId],   references: [id], onDelete: Cascade)
  chatMessages     DiplomacyMessage[]

  @@index([galaxyId])
  @@index([proposerFactionId])
  @@index([targetFactionId])
  @@index([status])
  @@index([galaxyId, type, status])
}

model DiplomacyMessage {
  id        Int      @id @default(autoincrement())
  treatyId  Int
  userId    Int
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  treaty FactionTreaty @relation(fields: [treatyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treatyId, createdAt])
}

model GalaxyEvent {
  id          Int       @id @default(autoincrement())
  galaxyId    Int
  type        String    @db.VarChar(64)
  title       String    @db.VarChar(128)
  description String    @db.VarChar(512)
  nexusId     Int?
  x           Int?
  y           Int?
  expiresAt   DateTime?
  resolvedAt  DateTime?
  meta        Json?
  createdAt   DateTime  @default(now())

  galaxy Galaxy @relation(fields: [galaxyId], references: [id], onDelete: Cascade)

  @@index([galaxyId])
  @@index([type])
  @@index([expiresAt])
}

model ReferralToken {
  id          Int       @id @default(autoincrement())
  referrerId  Int
  refereeId   Int
  galaxyId    Int       @default(0)
  redeemedAt  DateTime?
  rewardType  String?   @db.VarChar(32)
  rewardMeta  Json?

  referrer    User      @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([refereeId, galaxyId])
  @@index([refereeId])
  @@index([referrerId])
}

model MilestoneToken {
  id                 Int       @id @default(autoincrement())
  userId             Int
  milestone          Int
  redeemedAt         DateTime?
  rewardType         String?   @db.VarChar(32)
  rewardMeta         Json?
  kofiTransactionId  String?   @unique @db.VarChar(64)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Point-milestone tokens (positive `milestone`) are unique per user via the partial
  // index in migration 20260521040000_kofi_transaction_id. Ko-fi tokens use milestone=0
  // and dedupe via the unique kofiTransactionId column instead.
  @@index([userId])
}

enum WarOperationStatus {
  planning
  locked
  launched
  completed
  cancelled
}

model WarOperation {
  id              Int                @id @default(autoincrement())
  factionId       Int
  galaxyId        Int
  name            String             @db.VarChar(64)
  targetNexusId   Int
  targetX         Int
  targetY         Int
  targetName      String             @db.VarChar(64)
  arrivalAt       DateTime
  status          WarOperationStatus @default(planning)
  createdByUserId Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  rev             Int                @default(0)

  waves    WarOperationWave[]
  messages WarOperationMessage[]

  @@index([factionId, status])
  @@index([galaxyId])
  @@index([arrivalAt])
}

model WarOperationWave {
  id              Int      @id @default(autoincrement())
  operationId     Int
  ordinal         Int
  label           String?  @db.VarChar(48)
  arrivalOffsetMs Int      @default(0)
  troops          Json     @default("{}")
  createdAt       DateTime @default(now())

  operation WarOperation       @relation(fields: [operationId], references: [id], onDelete: Cascade)
  slots     WarOperationSlot[]
  attacks   Attack[]

  @@index([operationId, ordinal])
}

model WarOperationSlot {
  id            Int      @id @default(autoincrement())
  waveId        Int
  userId        Int
  fromNexusId   Int
  troops        Json     @default("{}")
  note          String?  @db.VarChar(128)
  sentAttackId  Int?
  claimedAt     DateTime @default(now())

  wave WarOperationWave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@unique([waveId, userId, fromNexusId])
  @@index([userId])
  @@index([waveId])
}

model DailyStreak {
  id             Int       @id @default(autoincrement())
  userId         Int
  galaxyId       Int
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastClaimedAt  DateTime?
  questsSeed     String?   @db.VarChar(32)
  questsProgress Json      @default("{}")
  questsClaimed  Boolean   @default(false)

  @@unique([userId, galaxyId])
  @@index([userId])
}

model WarOperationMessage {
  id          Int      @id @default(autoincrement())
  operationId Int
  userId      Int
  content     String   @db.VarChar(1000)
  kind        String   @default("chat") @db.VarChar(16)
  createdAt   DateTime @default(now())

  operation WarOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
}

model GameEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  galaxyId  Int?
  event     String   @db.VarChar(64)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, event])
  @@index([event, createdAt])
  @@index([galaxyId, event, createdAt])
}
