{
  "name": "Vexara-Server",
  "version": "1.0.0",
  "description": "Backend server for Vexara game",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsup",
    "start": "prisma generate && prisma migrate deploy && node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "node --import tsx/esm --test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^13.0.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "tsup": "^8.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.3",
    "nodemon": "^3.0.2",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
