{
  "name": "vexara-admin",
  "version": "1.0.0",
  "description": "Admin server for Vexara",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "npm install --prefix ../server --include=dev",
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "tsup": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
