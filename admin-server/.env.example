ADMIN_USER=replace_with_admin_username
ADMIN_PASS=replace_with_strong_password
# 32+ random hex chars — `openssl rand -hex 32`
ADMIN_SESSION_SECRET=replace_with_random_32_hex
# base32 — run `npx tsx scripts/generate-totp.ts` to mint
ADMIN_TOTP_SECRET=replace_with_base32_totp_secret
# Set false only for local http:// dev
ADMIN_COOKIE_SECURE=false
# Set to your admin subdomain in prod (e.g. admin.vexara.world); leave empty for localhost
ADMIN_COOKIE_DOMAIN=
ADMIN_TOTP_ENABLED=true
ADMIN_CORS_ORIGINS=http://localhost:3003