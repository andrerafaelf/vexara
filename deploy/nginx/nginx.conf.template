user nginx;
worker_processes auto;
worker_rlimit_nofile 65535;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 4096;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time upstream_rt=$upstream_response_time';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout       75;
    keepalive_requests      1000;
    types_hash_max_size     2048;
    server_tokens           off;

    # Output buffers — prevents slow client from blocking upstream goroutine
    proxy_buffering         on;
    proxy_buffer_size       16k;
    proxy_buffers           8 16k;
    proxy_busy_buffers_size 32k;

    # Gzip (fallback for clients that don't accept Brotli / Cloudflare already
    # delivers Brotli at the edge; this covers direct origin hits)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/json application/javascript application/x-javascript
        application/xml application/xml+rss application/atom+xml
        image/svg+xml font/woff font/woff2;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Unwrap Cloudflare's proxy so $remote_addr is the real client IP.
    # This makes allow/deny rules and rate-limit keys work correctly.
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    # Rate limits keyed on the real client IP (CF passes it in CF-Connecting-IP / X-Real-IP)
    limit_req_zone $http_cf_connecting_ip zone=api:10m rate=20r/s;
    limit_req_zone $http_cf_connecting_ip zone=auth:10m rate=10r/m;

    # Docker's embedded DNS — lazy upstream resolution so nginx starts
    # even if a backend isn't up yet, and recovers when containers restart.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream client_upstream {
        server client:3000;
        keepalive 64;
        keepalive_requests 1000;
        keepalive_timeout 60s;
    }
    upstream server_upstream {
        server server:3001;
        keepalive 64;
        keepalive_requests 1000;
        keepalive_timeout 60s;
    }
    upstream admin_client_upstream {
        server admin-client:3003;
        keepalive 32;
    }
    upstream admin_server_upstream {
        server admin-server:3002;
        keepalive 32;
    }

    # ─── HTTP → HTTPS redirect ────────────────────────────────────────────────
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Container healthcheck — no upstream dependency, no redirect.
        # Confirms nginx itself is alive and serving config.
        location = /nginx-health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ─── Player-facing app ────────────────────────────────────────────────────
    server {
        listen 443 ssl;
        http2 on;
        server_name DOMAIN_PLACEHOLDER;

        ssl_certificate /etc/letsencrypt/live/DOMAIN_PLACEHOLDER/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/DOMAIN_PLACEHOLDER/privkey.pem;
        ssl_trusted_certificate /etc/letsencrypt/live/DOMAIN_PLACEHOLDER/chain.pem;

        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location /api/ {
            limit_req zone=api burst=100 nodelay;
            proxy_pass http://server_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            proxy_read_timeout 60s;
            # Tell Cloudflare not to cache API responses
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        location /api/auth/ {
            limit_req zone=auth burst=5 nodelay;
            proxy_pass http://server_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        location = /healthz {
            proxy_pass http://server_upstream/healthz;
            access_log off;
        }

        # Socket.IO WebSocket endpoint — must reach the API server, not the Next.js app.
        # The client connects to wss://vexara.world/ws/?EIO=4&transport=websocket
        location /ws/ {
            proxy_pass http://server_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            # WebSocket connections are long-lived — don't time them out quickly.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Static assets — immutable hashed filenames from Next.js build
        location /_next/static/ {
            proxy_pass http://client_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            # Long TTL for origin; Cloudflare will also cache at edge
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            access_log off;
        }

        location / {
            proxy_pass http://client_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }

    # ─── Admin panel ──────────────────────────────────────────────────────────
    # deploy.sh writes /etc/nginx/admin.conf — populated if the admin cert
    # exists, empty otherwise (so a missing admin cert doesn't take down the
    # player-facing site).
    include /etc/nginx/admin.conf;
}
