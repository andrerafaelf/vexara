# Treble Quest - static site + leaderboard API, served from the same nginx
# container as Vexara. Source repo: andrerafaelf/treble-quest.
# Included by nginx.conf if the treble.quest SSL cert exists.
# deploy.sh writes an empty treble.conf if the cert is missing,
# so the player-facing site stays up regardless.
#
# One cert (lineage "treble.quest") covers treble.quest, www.treble.quest and
# api.treble.quest.
#
# The leaderboard API is a systemd service on the host, not a container. It
# binds to the docker0 gateway (172.17.0.1:8787), which this container reaches
# as host.docker.internal (extra_hosts: host-gateway in docker-compose.prod.yml).

upstream treble_api_upstream {
    server host.docker.internal:8787;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.treble.quest;

    ssl_certificate /etc/letsencrypt/live/treble.quest/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/treble.quest/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/treble.quest/chain.pem;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://treble.quest$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name treble.quest;

    ssl_certificate /etc/letsencrypt/live/treble.quest/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/treble.quest/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/treble.quest/chain.pem;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location /.well-known/acme-challenge/ {
        allow all;
        root /var/www/certbot;
    }

    root /var/www/treble-quest;
    index index.html;

    # Share-result pages are rendered by the API (per-run Open Graph tags)
    location /r/ {
        proxy_pass http://treble_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # Hashed build assets are safe to cache; filenames change on rebuild
    location ~* \.(?:css|js|mjs|svg|png|jpg|jpeg|gif|webp|avif|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    # Prerendered HTML must never be cached, content changes on deploy
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri.html $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.treble.quest;

    ssl_certificate /etc/letsencrypt/live/treble.quest/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/treble.quest/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/treble.quest/chain.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Multiplayer lobby WebSocket (wss://api.treble.quest/vs/ws). Without the
    # upgrade headers the handshake fails and lobbies stop updating live.
    location /vs/ws {
        proxy_pass http://treble_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://treble_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
